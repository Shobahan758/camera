<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve the Laravel application from /public when the hosting document root
    # cannot be configured to point there directly.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$) [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent direct access to sensitive Laravel and project files.
<FilesMatch "^(\.env|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js)$">
    Require all denied
</FilesMatch>
